                  "RangeOptimalEndValue": 7.6,
                  "RangeIndicatorRadius": 201.92307692307693,
                  "RangeIndicatorThickness": 4.615384615384615,
                  "BelowOptimalStyle": {
                    "ArcColor": "#00000000"
                  },
                  "OptimalStyle": {
                    "ArcColor": "#FF202C37"
                  },
                  "AboveOptimalStyle": {
                    "ArcColor": "#FFFF6B70",
                    "EnableLabelColor": false,
                    "LabelColor": "#FFFF6B70"
                  },
                  "Bindings": {
                    "Visible": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return a27rpmScale()!==null&&a27rpm()!==null;"
                      },
                      "Mode": 2
                    },
                    "Value": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return Math.max(0,(a27rpm()||0)/1000);"
                      },
                      "Mode": 2
                    },
                    "Maximum": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return Math.max(1,Math.ceil((a27rpmScale()||1000)/1000));"
                      },
                      "Mode": 2
                    },
                    "RangeOptimalEndValue": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return a27shift().threshold!==null?a27shift().threshold/1000:Math.max(1,Math.ceil((a27rpmScale()||1000)/1000));"
                      },
                      "Mode": 2
                    },
                    "RadialGaugeColor": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return a27color(!a27driving()?\"#FF738899\":a27shift().reached?\"#FFFFB35C\":\"#FF8CCEFF\");"
                      },
                      "Mode": 2
                    },
                    "MajorDivisionsCount": {
                      "Formula": {
                        "JSExt": 1,
                        "Interpreter": 1,
                        "Expression": "return Math.max(1,Math.ceil((a27rpmScale()||1000)/1000/10));"
                      },
                      "Mode": 2
                    }
                  }
                },
